<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="100dp" />
            <solid android:color="#40000000" />
            <padding android:bottom="2dp" />
        </shape>
    </item>

    <item>
        <shape>
            <corners android:radius="100dp" />
            <solid android:color="@color/white" />
            <padding
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp" />
        </shape>
    </item>

    <item>
        <shape>
            <corners android:radius="100dp" />

            <solid android:color="@color/green_00838F" />

            <stroke
                android:width="1dp"
                android:color="@color/green_003B50" />

        </shape>
    </item>

    <item
        android:drawable="@drawable/ic_bubble_top"
        android:gravity="top|start"
        android:start="6dp"
        android:top="3dp" />

</layer-list>