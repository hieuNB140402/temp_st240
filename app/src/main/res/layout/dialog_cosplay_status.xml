<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <!--            imvBack-->
            <ImageView
                android:id="@+id/imvBack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/img_dialog_cosplay_back"
                app:layout_constraintTop_toTopOf="parent" />

            <!--            lnlContent-->
            <LinearLayout
                android:id="@+id/lnlContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="64dp"
                android:background="@drawable/bg_dialog"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!--                    imvAura-->
                    <ImageView
                        android:id="@+id/imvAura"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:src="@drawable/img_dialog_cosplay_aura" />

                    <!--                    imvContent-->
                    <ImageView
                        android:id="@+id/imvContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="28dp"
                        android:layout_marginTop="48dp"
                        android:adjustViewBounds="true"
                        android:src="@drawable/img_dialog_cosplay_content_win" />
                </FrameLayout>


                <!--                btnNext-->
                <com.meskiep.vaithat.core.custom.text.StrokeTextView
                    android:id="@+id/btnNext"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="56dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_100_button_focus_app_long"
                    android:fontFamily="@font/cookies"
                    android:gravity="center"
                    android:text="@string/next"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    app:strokeColor="@color/green_003B50"
                    app:strokeJoinStyle="round"
                    app:strokeMiter="5dp"
                    app:strokeWidth="2dp" />
            </LinearLayout>

            <!--            imvStatus-->
            <ImageView
                android:id="@+id/imvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="60dp"
                android:layout_marginBottom="-72dp"
                android:adjustViewBounds="true"
                android:src="@drawable/img_dialog_cosplay_win"
                app:layout_constraintBottom_toTopOf="@+id/lnlContent"
                app:layout_constraintTop_toTopOf="@+id/imvBack" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</layout>