<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.emoji_maker.BrushFragment">

    <include layout="@layout/layout_background" />

    <!--    layoutActionBar-->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <!--    flSave-->
    <FrameLayout
        android:id="@+id/flSave"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/gl052"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar">

        <!--        rasmView-->
        <com.raed.rasmview.RasmView
            android:id="@+id/rasmView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/transparent" />
    </FrameLayout>


    <!--    gl052-->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl052"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.60" />

    <!--    cvUndo-->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvUndo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="1000dp"
        app:cardElevation="3dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gl052">

        <!--        btnUndo-->
        <ImageView
            android:id="@+id/btnUndo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_emoji_maker_undo_not_enable" />
    </androidx.cardview.widget.CardView>

    <!--    cvRedo-->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvRedo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="1000dp"
        app:cardElevation="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/cvUndo"
        app:layout_constraintStart_toEndOf="@+id/cvUndo"
        app:layout_constraintTop_toTopOf="@+id/cvUndo">

        <!--        btnRedo-->
        <ImageView
            android:id="@+id/btnRedo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_emoji_maker_redo_not_enable" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="@color/yellow_FFEDBB"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvUndo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="horizontal">

            <!--            flBrush-->
            <FrameLayout
                android:id="@+id/flBrush"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@color/yellow_FFD364">

                <!--                btnBrush-->
                <ImageView
                    android:id="@+id/btnBrush"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_emoji_maker_brush_selected" />
            </FrameLayout>

            <!--            flEraser-->
            <FrameLayout
                android:id="@+id/flEraser"
                android:layout_width="52dp"
                android:layout_height="52dp">

                <!--                btnEraser-->
                <ImageView
                    android:id="@+id/btnEraser"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_emoji_maker_eraser_unselect" />
            </FrameLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/black" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:weightSum="2">

            <!--            lnlColor-->
            <LinearLayout
                android:id="@+id/lnlColor"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/cookies"
                    android:text="@string/color"
                    android:textColor="@color/green_003B50"
                    android:textSize="16sp" />

                <!--                rcvColor-->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvColor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_dialog_text_color" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/cookies"
                    android:text="@string/size"
                    android:textColor="@color/green_003B50"
                    android:textSize="16sp" />

                <!--                sbSize-->
                <com.meskiep.vaithat.core.custom.seekbar.SizeSliderView
                    android:id="@+id/sbSize"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>